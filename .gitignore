# =============================================================================
# .gitignore — jol-infrastructure
# Blocks all sensitive files, state, and local artifacts from version control
# =============================================================================

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc

# Plan output files
*.tfplan
plan-output.txt
plan-detail.txt

# --- Certificates & Keys ---
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
kubeconfig
kubeconfig.*

# --- Secrets & Credentials ---
*.secret
*.credentials
.env
.env.*

# --- IDE ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/
dist/
build/
.eggs/

# --- Node ---
node_modules/
package-lock.json

# --- OS ---
.DS_Store
Thumbs.db
*.bak
*.tmp

# --- Docker ---
docker-compose.override.yml

# --- Helm ---
helm/charts/*/charts/
helm/charts/*/*.tgz

# --- Qodana ---
qodana-results/
.qodana/

# --- SBOM / Audit artifacts ---
sbom/
soc2-evidence-*/

# --- Terraform bootstrap backend template ---
terraform/bootstrap/backend.tpl
