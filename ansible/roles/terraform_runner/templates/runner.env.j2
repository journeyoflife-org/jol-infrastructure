# =============================================================================
# runner.env — NON-SECRET runner configuration (managed by terraform_runner role)
# Secrets (GH_JIT_TOKEN, PM_API_TOKEN, SOPS age key) live in
# {{ terraform_secrets_dir }}/runner.secrets.env (0400 root:root), injected at
# runtime from Vaultwarden — NEVER committed here (AGENTS.md §0.1).
# =============================================================================
RUNNER_ORG={{ actions_runner_org }}
GH_API={{ actions_runner_api }}

# Terraform CLI config (plugin cache, no telemetry checkpoint).
TF_CLI_CONFIG_FILE={{ terraform_cli_config_file }}

# SOPS reads the runtime-injected age private key from this path.
SOPS_AGE_KEY_FILE={{ terraform_secrets_dir }}/age.key

# Non-secret Terraform state backend (PostgreSQL `pg` backend) + Proxmox coords.
# PGPASSWORD and PM_API_TOKEN (the CREDENTIALS) are injected via runner.secrets.env.
# The pg backend reads PG_CONN_STR + standard libpq env vars; each Terraform
# config uses an empty `backend "pg" {}` block so no secret lands in .tf/.terraform.
PG_CONN_STR=postgres://{{ terraform_state_db_host }}:{{ terraform_state_db_port }}/{{ terraform_state_db_name }}?sslmode={{ terraform_state_db_sslmode }}
PG_SCHEMA_NAME={{ terraform_state_db_schema }}
PGUSER={{ terraform_state_db_user }}
PM_API_URL={{ proxmox_api_endpoint }}
PM_API_TOKEN_ID={{ proxmox_api_token_id }}
