{
  "hostname": "llm-prod-lt01",
  "version": 3,
  "title": "JOL LLM Platform — llm-prod-lt01 Overview",
  "theme": "slate",
  "description": "Operational overview of the self-hosted LLM platform: Ollama runtime, API bridge throughput, thermal and memory headroom, and NVMe health. Exported from the Netdata UI; commit a fresh export after any dashboard change (docs/04-operations/monitoring-dashboards.md). Telemetry only — no prompt content is ever captured.",
  "refresh": 10,
  "charts": [
    {
      "id": "jol_llm.status",
      "source": "charts.d/ollama",
      "type": "line",
      "title": "LLM platform status",
      "dimensions": ["ollama_up", "bridge_up", "model_resident"],
      "size": "wide"
    },
    {
      "id": "prometheus.ollama_generate_tokens_per_second",
      "source": "prometheus/ollama",
      "type": "area",
      "title": "Generation throughput (tok/s)",
      "dimensions": ["tokens_per_second"],
      "size": "wide",
      "notes": "Baseline on 3950X CPU inference: qwen3-32b-q8_0 ≈ 1.4 tok/s. Alert below 0.7 (warn) / 0.3 (crit)."
    },
    {
      "id": "prometheus.ollama_bridge_queue_depth",
      "source": "prometheus/ollama",
      "type": "line",
      "title": "Bridge queue depth",
      "dimensions": ["queue_depth"],
      "size": "half"
    },
    {
      "id": "prometheus.ollama_bridge_requests_5xx_total",
      "source": "prometheus/ollama",
      "type": "line",
      "title": "Bridge 5xx responses (cumulative)",
      "dimensions": ["requests_5xx_total"],
      "size": "half"
    },
    {
      "id": "prometheus.ollama_model_size_bytes",
      "source": "prometheus/ollama",
      "type": "stacked",
      "title": "Resident model RAM footprint",
      "dimensions": ["size_bytes"],
      "size": "half"
    },
    {
      "id": "system.ram",
      "source": "proc",
      "type": "stacked",
      "title": "System RAM (96 GB)",
      "dimensions": ["free", "used", "cached", "buffers"],
      "size": "half",
      "notes": "Model-load floor: warn < 25 GiB free, crit < 12 GiB free."
    },
    {
      "id": "sensors.temperature_generic",
      "source": "sysfs",
      "type": "line",
      "title": "3950X package temperature",
      "dimensions": ["temp"],
      "size": "half",
      "notes": "Warn > 82 °C, crit > 88 °C — throttling risk for inference."
    },
    {
      "id": "disk_space./opt/jol/models",
      "source": "diskspace",
      "type": "line",
      "title": "NVMe free space (/opt/jol/models)",
      "dimensions": ["avail"],
      "size": "half"
    }
  ],
  "alerts": [
    { "template": "llm_tokens_per_sec", "severity": "warning" },
    { "template": "llm_queue_depth", "severity": "warning" },
    { "template": "llm_model_resident", "severity": "critical" },
    { "template": "cpu_temperature_llm", "severity": "warning" },
    { "template": "ram_free_llm", "severity": "warning" },
    { "template": "exporter_staleness_llm", "severity": "warning" }
  ],
  "routing": {
    "default": ["local syslog", "email: llm-alerts@jol.internal (internal SMTP relay)"]
  }
}
