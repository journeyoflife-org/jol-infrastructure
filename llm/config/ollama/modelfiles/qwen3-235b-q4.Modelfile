# Modelfile: reserved model — Qwen3-235B-A22B Q4_K_M (MoE)
# STATUS: reserved. Requires >= 160 GB RAM; NOT servable on llm-prod-lt01.
# Kept here so activation after the hardware refresh is a one-command step.

FROM /opt/jol/models/gguf/qwen3-235b-a22b-q4_k_m.gguf

PARAMETER temperature 0.7
