From 24c4e1304f396fac81bd2786933c16acd771ed64 Mon Sep 17 00:00:00 2001
From: Gintaras Kazlauskas <journey4oflife@gmail.com>
Date: Thu, 27 Aug 2026 01:05:05 +0300
Subject: [PATCH] sec(sops): enable SOPS recipient + encrypted-secrets root

Gate 8 authorized fleet enablement (journeyoflife-org/jol-infrastructure#36).
PUBLIC recipient only; creation rules *.enc.yaml|json + secrets/encrypted/**.
Rollback: revert this commit.
---
 .sops.yaml                  | 11 +++++++++++
 secrets/encrypted/README.md |  8 ++++++++
 2 files changed, 19 insertions(+)
 create mode 100644 .sops.yaml
 create mode 100644 secrets/encrypted/README.md

diff --git a/.sops.yaml b/.sops.yaml
new file mode 100644
index 0000000..95fe742
--- /dev/null
+++ b/.sops.yaml
@@ -0,0 +1,11 @@
+# JOL Platform — SOPS creation rules (ADR-003 amendment PR #35; Gate 8 GO 2026-08-27)
+# TREE: Church (/opt/jol/**) — recipient below ONLY. Cross-tree recipients are a segregation
+# incident (amendment rule 1). Private key: Vaultwarden SOPS-Custody + Shamir
+# custody. Counterpart config: marketplace: jol-m-compliance .sops.yaml. PUBLIC recipient only.
+creation_rules:
+  - path_regex: \.enc\.ya?ml$
+    age: age17ne7fvag6gxedsgs4yzpefqe5t8uefp4ldezrc7ajfqyjad79g5qsv0rn2  # pragma: allowlist secret
+  - path_regex: \.enc\.json$
+    age: age17ne7fvag6gxedsgs4yzpefqe5t8uefp4ldezrc7ajfqyjad79g5qsv0rn2  # pragma: allowlist secret
+  - path_regex: ^secrets/encrypted/
+    age: age17ne7fvag6gxedsgs4yzpefqe5t8uefp4ldezrc7ajfqyjad79g5qsv0rn2  # pragma: allowlist secret
diff --git a/secrets/encrypted/README.md b/secrets/encrypted/README.md
new file mode 100644
index 0000000..e7cbb90
--- /dev/null
+++ b/secrets/encrypted/README.md
@@ -0,0 +1,8 @@
+# Encrypted secrets root (ADR-003 amendment, R3 convention)
+
+Files committed here MUST be genuine SOPS output (`sops --encrypt --in-place`).
+Plaintext in this directory is a security incident: remove from history and
+rotate. Decrypt for use: `SOPS_AGE_KEY_FILE=<identity> sops -d <file>` —
+never into a tracked path. See jol-infrastructure
+`docs/security/sops-rollout-instructions.md` (church) /
+`SOPS-PUBLICATION.md` in jol-m-compliance (marketplace).
-- 
